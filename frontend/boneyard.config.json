{
  "breakpoints": [320, 390, 768, 1024, 1440],
  "out": "./components/admin/bones",
  "wait": 250,
  "color": "#e7e8f1",
  "darkColor": "#202044",
  "animate": "pulse",
  "speed": "1.8s",
  "transition": 180,
  "select": "viewport",
  "resolveEnvVars": true,
  "auth": {
    "headers": {
      "x-boneyard-capture": "env[BONEYARD_CAPTURE_TOKEN]"
    }
  }
}
